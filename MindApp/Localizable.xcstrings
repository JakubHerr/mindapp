    "infosheet_wi_dayscore_header" : {
      "comment" : "Header of dayscore info section",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informace o grafu"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About graph"
          }
        }
      }
    },
    "infosheet_wi_dayscore_text" : {
      "comment" : "Text of dayscore info section",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graf prezentuje denní průměrné hodnoty HRV za vybrané časové období. Barvy na grafu odpovídají frekvenci výskytu určeného stresového stavu během jednotlivých dní.\n\nBarevné označení pod sloupci grafu je vizuálním indikátorem, zda si uživatel v průběhu dne našel čas na mindfulness seanci.\n\nVíce informací najdete v sekci často kladených otázek v nastavení aplikace."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The graph presents the daily average HRV values for the selected time period. The colors on the graph correspond to the frequency of occurrence of the specified stress condition during each day.\n\nThe coloured markings below the bars of the chart are a visual indicators of whether the user has found time for a mindfulness session during the day.\n\nFor more information, see the FAQ section in the application settings."
          }
        }
      }
    },
    "infosheet_wi_timeofday_header" : {
      "comment" : "Header of time of day info section",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informace o grafu"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About graph"
          }
        }
      }
    },
    "infosheet_wi_timeofday_text" : {
      "comment" : "Text of time of day info section",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro vizualizaci nejvíce stresujících částí dne prezentuje graf nejčetnější frekvence výskytu stresových stavů v každé hodině v průběhu celého dne za vybrané časové období.\n\nŘádek v každém dni je rozdělený na dvě části. Horní část reprezentuje úroveň stresu a spodní část představuje, zda si uživatel v průběhu dne v dané hodině našel čas na mindfulness seanci.\n\nVíce informací najdete v sekci často kladených otázek v nastavení aplikace."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To visualise the most stressful parts of the day, the chart presents the most frequency of occurrence of stressful conditions in each hour throughout the day for the selected time period.\n\nThe row in each day is divided into two parts. The top part represents the level of stress and the bottom part represents whether the user found time for a mindfulness session during that hour of the day.\n\nFor more information, see the FAQ section in the application settings."
          }
        }
      }
    },
