    "reflection_card_title" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflexe"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflection"
          }
        }
      }
    },
    "reflection_description" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při reflexi vám budou kladeny otázky vygenerované umělou inteligencí, cílené na Váš den a jeho konkrétní specifika. Celé sezení se skládá ze tří kol otázek a odpovědí - po zahájení umělá inteligence vygeneruje úvodní tři otázky, z těchto otázek si máte možnost vybrat jednu, která Vám vyhovuje nejlépe. Po odeslání odpovědi na zvolenou otázku UI vygeneruje další tři otázky, akorát tentokrát se pokusí zaměřit otázky na kontext Vaší odpovědi. Celkem se tímto způsobem vygenerují tři trojice otázek, z čehož odpovíte na 3. Po poslední odpovědi se přesunete do formuláře obsahující otázky ohledně vyhodnocení sezení."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During reflection session, you will be given sets of 3 questions generated by artificial intelligence targeted at your day and its specifics. The entire session consists of three rounds of questions and answers - at the beginning, AI generates first three questions. You will choose one of those three questions which fits you best. After sending your answer to the chosen question, the AI will generate next three questions, this time targeted at the context of your first answer. In total, the session consists of three rounds of three questions, of which you will answer three. After the last answer, you will move to a form consisting of questions regarding the evaluation of the session."
          }
        }
      }
    },
