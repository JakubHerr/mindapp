    "mind_breathing_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Série řízených dechových cvičení, která vám pomohou uvolnit se."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A series of guided breathing exercises to help you relax."
          }
        }
      }
    },
    "mind_meditation_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meditace pro zklidnění mysli a duše."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meditations to calm the mind and soul."
          }
        }
      }
    },
    "mind_session_breathing_safety_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Pozor na zdravotní stav: Pokud máte respirační problémy, srdeční onemocnění nebo jiné zdravotní problémy, konzultujte před zahájením pravidelného cvičení dýchání s lékařem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Be cautious with your health: If you have respiratory issues, heart conditions, or other health concerns, consult a doctor before starting regular breathing exercises."
          }
        }
      }
    },
    "mind_session_breathing_safety_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Při závrati zastavte: Pokud během dýchání pocítíte závratě nebo nepohodlí, okamžitě přestaňte a vraťte se k normálnímu dýchání."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Stop if you feel dizzy: If you experience dizziness or discomfort while breathing, stop immediately and return to normal breathing."
          }
        }
      }
    },
    "mind_session_breathing_safety_3" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Necvičte při řízení: Nikdy neprovádějte dechová cvičení během řízení nebo v situacích, které vyžadují vaši plnou pozornost a reakce."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Do not practice while driving: Never perform breathing exercises while driving or in situations that require your full attention and quick reactions."
          }
        }
      }
    },
    "mind_session_by" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
