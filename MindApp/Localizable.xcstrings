    },
    "infosheet_daily_stress_stressed_text" : {
      "comment" : "Text label",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV je hluboko pod průměrem HRV."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV is well below the average HRV."
