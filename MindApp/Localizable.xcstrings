    "mind_session_meditation_safety_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Vyberte si bezpečné prostředí: Ujistěte se, že meditujete na bezpečném a pohodlném místě, kde nebudete rušeni nebo s rizikem usnutí v nebezpečné pozici."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Choose a safe environment: Ensure that you meditate in a safe and comfortable place where you won't be disturbed or at risk of falling asleep in an unsafe position."
          }
        }
      }
    },
    "mind_session_meditation_safety_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Buďte si vědomi svého duševního stavu: Pokud během meditace zažíváte intenzivní emoce nebo stres, udělejte si přestávku a v případě potřeby se poraďte s odborníkem na duševní zdraví."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Be mindful of your mental state: If you experience intense emotions or distress during meditation, take a break and consult with a mental health professional if necessary."
          }
        }
      }
    },
    "mind_session_meditation_safety_3" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Nemeditujte při řízení nebo obsluze strojů: Nikdy nemeditujte při řízení nebo při činnostech, které vyžadují vaši plnou pozornost a bdělost."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Avoid meditating while driving or operating machinery: Never meditate while driving or engaging in activities that require your full attention and alertness."
          }
        }
      }
    },
